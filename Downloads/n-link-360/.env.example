# ==============================================================================
# N-LINK 360: Environment Configuration Template
# Project: N-LINK360
# Company: National Lights
# ==============================================================================

# Application Environment (development | production)
NODE_ENV=production
PORT=3000

# Application Base URL
APP_URL=https://app.nationallight.pk

# Supabase / PostgreSQL Project
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY

# Server-Side Only Secrets. NEVER commit real values.
SUPABASE_JWT_SECRET=YOUR_SERVER_ONLY_JWT_SECRET
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@YOUR-PROJECT.supabase.co:5432/postgres

# System owner email
SYSTEM_OWNER_EMAIL=your-company-email@example.com
