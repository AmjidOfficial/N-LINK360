# Application Environment (development | production)
NODE_ENV=development
PORT=3000

# Google AI Studio / Gemini API (Server-side only)
GEMINI_API_KEY=

# Application Base URL
APP_URL=

# Supabase / PostgreSQL (Free-First Tier Configuration)
# Public Client Variables
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-Side Only Secrets (NEVER expose to client/browser)
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Free Email Service Contact
SYSTEM_OWNER_EMAIL=nationallights2026@gmail.com

