# ==============================================================================
# N-LINK 360: Environment Configuration Template
# Copy to .env for local development or configure in Netlify Site Settings.
# NEVER expose private service-role keys or admin passwords in VITE_* variables.
# ==============================================================================

# Supabase Public Client Credentials (Safe for browser bundle)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional External Node/Express Backend Base URL (leave blank for static Netlify hybrid mode)
VITE_API_BASE_URL=

# Server-Side Only Variables (Configure on Node backend / Edge Functions ONLY)
SUPABASE_SERVICE_ROLE_KEY=
NLINK_SESSION_SECRET=
GOOGLE_SHEETS_WEBHOOK_URL=
GEMINI_API_KEY=
