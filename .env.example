# ==============================================================================
# N-LINK 360: Forever-Free ($0/Month) Environment Configuration Template
# Copy to .env for local development or configure in Cloudflare Pages / GitHub Actions.
# NEVER expose private service-role keys or admin passwords in VITE_* variables.
# ==============================================================================

# Supabase Free Tier Public Client Credentials (Safe for browser bundle)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional Google Apps Script Web App URL for Direct Browser Sync (Free Forever)
VITE_GOOGLE_SHEETS_WEBHOOK_URL=

# Optional External Backend Base URL (leave blank for Cloudflare Pages Functions / Static Mode)
VITE_API_BASE_URL=

# Server / Cloudflare Pages Edge Functions Variables (Configure in Dashboard Secrets ONLY)
SUPABASE_SERVICE_ROLE_KEY=
NLINK_SESSION_SECRET=
GOOGLE_SHEETS_WEBHOOK_URL=
GEMINI_API_KEY=
